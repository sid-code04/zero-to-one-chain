create or replace transient table ZERO_TO_ONE_CHAIN.PUBLIC_L5_CORE.dim_supplier
         as
        (-- Conformed supplier dimension: golden record from ERP + SRM entity resolution


WITH erp AS (
    SELECT * FROM ZERO_TO_ONE_CHAIN.L1_INGESTION.RAW_ERP_VENDORS
),
srm AS (
    SELECT * FROM ZERO_TO_ONE_CHAIN.L1_INGESTION.RAW_SRM_SUPPLIERS
),
crosswalk AS (
    SELECT
        e.vendor_code AS supplier_id,
        e.vendor_name AS supplier_name,
        e.vendor_region AS region,
        e.country_code AS country,
        e.vendor_tier AS tier,
        e.vendor_status AS erp_status,
        e.primary_category,
        e.certifications,
        e.onboarding_date,
        e.annual_spend_usd_mm,
        e.avg_lead_time_days AS lead_time_days,
        e.historical_otd_pct AS otd_pct,
        e.defect_rate_ppm AS defect_ppm,
        e.financial_risk_score,
        e.geopolitical_risk_score,
        e.payment_terms,
        e.company_size,
        e.employee_count,
        e.dual_source_available,
        e.last_audit_date,
        e.last_audit_result,
        s.quality_score,
        s.delivery_reliability_pct,
        s.responsiveness_score,
        s.innovation_score,
        s.sustainability_score,
        s.cost_competitiveness_idx,
        s.esg_compliance_status,
        s.carbon_intensity_score,
        s.concentration_risk,
        ROUND(
            COALESCE(e.financial_risk_score, 3) * 0.3 +
            COALESCE(e.geopolitical_risk_score, 3) * 0.2 +
            (10 - COALESCE(s.quality_score, 70) / 10) * 0.25 +
            (10 - COALESCE(s.delivery_reliability_pct, 70) / 10) * 0.25
        , 2) AS blended_risk_score,
        CASE
            WHEN e.vendor_code = s.erp_vendor_ref THEN 'EXACT_KEY'
            ELSE 'FUZZY'
        END AS match_method
    FROM erp e
    LEFT JOIN srm s ON e.vendor_code = s.erp_vendor_ref
)
SELECT * FROM crosswalk
        );
